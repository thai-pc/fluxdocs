{
  "name": "@fluxdocs/core",
  "version": "0.1.0",
  "description": "FluxDocs client-side PDF SDK (WebAssembly). Privacy-first: documents are processed entirely in the browser and never sent to a server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.mjs"
  },
  "keywords": [
    "pdf",
    "wasm",
    "webassembly",
    "privacy",
    "annotation",
    "fluxdocs"
  ],
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
