{
  "name": "vue-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cd ../.. && GOOS=js GOARCH=wasm go build -o examples/vue-demo/public/fluxdocs.wasm ./wasm && cp \"$(go env GOROOT)/lib/wasm/wasm_exec.js\" examples/vue-demo/public/wasm_exec.js",
    "typecheck": "vue-tsc --noEmit",
    "build": "pnpm build:wasm && vite build",
    "dev": "pnpm build:wasm && vite"
  },
  "dependencies": {
    "@fluxdocs/core": "workspace:*",
    "@fluxdocs/vue": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.1.10"
  }
}
